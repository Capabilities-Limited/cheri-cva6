{
    // Name of the project
    name: "capltd_pulp_axi",

    // Target directory: relative to the location of this script.
    target_dir: "capltd/pulp_axi",

    // Upstream repository: Capabilities Limited additions to pulp-platform/axi
    // (`axi_hazard_filter`, beat-limiting `axi_throttle`), ported to the common_cells v1
    // naming used by vendor/pulp-platform/common_cells.
    upstream: {
        // URL
        url: "https://github.com/Capabilities-Limited/pulp_axi.git",
        // revision: head of branch `axi_cheri_tag_controller_ordering_dependencies`
        rev: "7c368c88e09aabc96db4cc4b2497530023b87dc5",
    }

    // Exclusions from upstream content
    exclude_from_upstream: [
        // Only used by Bender-based consumers (e.g. axi_cheri_tagcontroller).
        "Bender.yml",
    ]
}
